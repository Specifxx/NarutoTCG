{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "DATABASE_URL", "DATABASE_POOL_MAX", "FX_EUR_USD",
        "TCGPLAYER_AFFILIATE_URL", "EBAY_CAMPAIGN_ID", "EBAY_CUSTOM_ID", "CARDMARKET_REFERRER",
        "NEXT_PUBLIC_*"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL", "DATABASE_POOL_MAX", "FX_EUR_USD", "CRON_SECRET",
        "TCGPLAYER_AFFILIATE_URL", "EBAY_CAMPAIGN_ID", "EBAY_CUSTOM_ID", "CARDMARKET_REFERRER"
      ]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "env": ["TEST_DATABASE_URL"] }
  }
}
