# Copy to .env.local. Every variable is optional.

# PostgreSQL / Supabase connection string. Unset = built-in demo data (read-only, dry-run ingestion).
# Supabase: use the pooled connection string (port 6543); prepared statements are disabled for it.
DATABASE_URL=
# Connection pool size per server instance (default 5).
DATABASE_POOL_MAX=

# Shared secret for /api/prices/cron, sent as "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron sends it automatically. Required in production; unset in development allows unauthenticated calls.
CRON_SECRET=

# EUR → USD rate used to normalize Cardmarket prices (a payload may override it per batch).
FX_EUR_USD=1.16

# Affiliate tracking. Unset = plain marketplace links.
# Impact deep-link base, e.g. https://tcgplayer.pxf.io/c/<publisher>/<ad>/<campaign>
TCGPLAYER_AFFILIATE_URL=
# eBay Partner Network campaign id (and optional custom id for reporting).
EBAY_CAMPAIGN_ID=
EBAY_CUSTOM_ID=
CARDMARKET_REFERRER=

# Cross-app navigation. Unset = http://localhost:<port> in development.
NEXT_PUBLIC_SIMULATOR_URL=
NEXT_PUBLIC_DECKS_URL=
NEXT_PUBLIC_COMPARE_URL=
NEXT_PUBLIC_LEARN_URL=
