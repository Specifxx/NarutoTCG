# Copy to .env.local. Development works with none of these set (demo data, dry-run ingestion).
# Production needs CRON_SECRET, the NEXT_PUBLIC_*_URL variables at build time, and DATABASE_URL for real prices.

# PostgreSQL / Supabase connection string. Unset = built-in demo data (read-only, dry-run ingestion).
# Supabase: use the pooled connection string (port 6543); prepared statements are disabled for it.
# TLS is required for non-local hosts: append ?sslmode=require (the dashboard's pooled string has no sslmode).
# Set sslmode=disable only for a trusted local database.
# e.g. postgres://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Connection pool size per server instance (default 5).
DATABASE_POOL_MAX=

# Shared secret for /api/prices/cron, sent as "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron sends it automatically. Required in production (the endpoint answers 503 without it);
# unset in development allows unauthenticated calls.
CRON_SECRET=

# EUR → USD rate used to normalize Cardmarket prices (a payload may override it per batch).
FX_EUR_USD=1.16

# Affiliate tracking. Unset = plain marketplace links.
# Impact deep-link base, e.g. https://tcgplayer.pxf.io/c/<publisher>/<ad>/<campaign>
TCGPLAYER_AFFILIATE_URL=
# eBay Partner Network campaign id (and optional custom id for reporting).
EBAY_CAMPAIGN_ID=
EBAY_CUSTOM_ID=
CARDMARKET_REFERRER=

# Cross-app navigation: each app's public URL. Inlined at BUILD time, so set them in the build
# environment and rebuild after a change. Required for production builds: without one, the header
# hides the link to that app (the build prints a warning). Unset in development = http://localhost:<port>.
# NEXT_PUBLIC_COMPARE_URL is also this app's own canonical URL (metadataBase).
NEXT_PUBLIC_SIMULATOR_URL=
NEXT_PUBLIC_DECKS_URL=
NEXT_PUBLIC_COMPARE_URL=
NEXT_PUBLIC_LEARN_URL=
