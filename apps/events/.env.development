# Sibling zones run on their own ports in local dev (see the root README).
# In production every zone is served from one origin, so these stay unset and
# the header links to /learn, /decks, ... directly.
NEXT_PUBLIC_ZONE_URL_SIMULATOR=http://localhost:3000
NEXT_PUBLIC_ZONE_URL_DECKS=http://localhost:3001
NEXT_PUBLIC_ZONE_URL_COMPARE=http://localhost:3002
NEXT_PUBLIC_ZONE_URL_LEARN=http://localhost:3003

# Optional: replace the default Esri dark basemap on /events/map with another raster style.
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?api_key=...
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
# NEXT_PUBLIC_MAP_TILE_SUBDOMAINS=abcd
